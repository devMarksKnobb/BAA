{
  "name": "aime-migration-engine",
  "version": "0.4.0",
  "description": "AIME \u2014 extensible, recoverable data migration and synchronization engine",
  "type": "module",
  "bin": {
    "aime": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./adapters": "./dist/adapters/index.js",
    "./security": "./dist/security/index.js",
    "./notion": "./dist/connectors/notion.js",
    "./sync": "./dist/sync/index.js",
    "./queue": "./dist/queue/index.js",
    "./identity": "./dist/identity/index.js",
    "./providers": "./dist/providers/index.js",
    "./google-drive": "./dist/connectors/google-drive.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "web": "tsx src/web/server.ts",
    "mcp": "tsx src/mcp/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-to-markdown": "^2.1.2",
    "multer": "^2.1.1",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.4"
  }
}
