# Durable SQLite migration journal (Node.js 22+)
AIME_STATE_DB=.aime/state.sqlite
PORT=3000
# Optional future integrations should use secret manager references, not plaintext credentials.
# Identity/session data (local SQLite)
AIME_IDENTITY_DB=.aime/identity.sqlite
AIME_CONNECTION_DB=.aime/connections.sqlite
AIME_CREDENTIAL_DB=.aime/credentials.sqlite
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AIME_MASTER_KEY=
# Provider OAuth apps; redirect URI must exactly match provider configuration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3000/oauth/callback/notion
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/oauth/callback/google-drive
# PostgreSQL URL is consumed by the host application that constructs a pg.Pool and injects it into PostgresJobQueue/PostgresSyncStore
DATABASE_URL=postgres://aime:aime-change-me@localhost:5432/aime
